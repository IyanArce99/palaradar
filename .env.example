# Copia este archivo como .env.local y rellena los valores. En desarrollo ninguno
# es obligatorio: sin DATABASE_URL el proyecto arranca con los datos seed en
# memoria. En producción hace falta DATABASE_URL (o DATA_SOURCE=mock, a propósito).

# --- Base de datos -----------------------------------------------------------
# Cadena de conexión a PostgreSQL. En Supabase: Project Settings → Database →
# Connection string (pooler). Si la contraseña tiene caracteres especiales,
# codifícalos (p. ej. @ → %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:5432/postgres

# Fuerza el origen de datos: "database" o "mock". Por defecto se usa la base de
# datos si DATABASE_URL está configurada; si no, los datos seed en memoria en
# desarrollo y un error en producción (nunca datos demo sin pedirlo).
# DATA_SOURCE=mock

# Conexiones máximas por proceso (el pooler de Supabase en modo sesión admite pocas).
# La ingestión de precios necesita al menos 2: una la ocupa su bloqueo.
# DATABASE_POOL_MAX=2

# --- Precios -----------------------------------------------------------------
# Horas desde la última comprobación a partir de las cuales un precio deja de
# presentarse como "de hoy" y pasa a "último precio conocido".
# PRICE_CURRENT_HOURS=24

# Horas a partir de las cuales el precio se da por desactualizado ("sin confirmar").
# PRICE_STALE_AFTER_HOURS=48

# Solo desarrollo: "true" para que las tiendas de demostración (stores.is_demo,
# las que crea `npm run db:seed:dev`) cuenten como precio. Con NODE_ENV=production
# se ignora: en producción solo cuentan las tiendas reales. Úsalo únicamente
# contra una base de datos de desarrollo y ejecuta `npm run db:stats` al cambiarlo.
# INCLUDE_DEMO_PRICES=false

# --- Imágenes ----------------------------------------------------------------
# Las fotos de las palas se guardan en Supabase Storage (bucket público «media»).
# URL del proyecto: Project Settings → API → Project URL. La web la usa para
# servir las fotos; sin ella, las palas muestran su ilustración.
# SUPABASE_URL=https://<project-ref>.supabase.co

# Clave secreta de Supabase (Project Settings → API Keys → Secret key, o la
# antigua service_role). SECRETA: da acceso total al proyecto. Solo la leen los
# scripts de importación (`npm run media:import`), que se ejecutan en local o en
# un proceso de backend. La web nunca la usa: NO la configures en el hosting de
# producción ni le pongas el prefijo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Alertas de precio -------------------------------------------------------
# Los correos de las alertas (confirmación y aviso) se envían con Resend.
# Clave de API de Resend (resend.com → API Keys). SECRETA: solo servidor, sin
# prefijo NEXT_PUBLIC_. Sin ella, la ficha no puede crear alertas.
# RESEND_API_KEY=

# Remitente de los correos. Tiene que ser de un dominio verificado en Resend.
# ALERTS_FROM_EMAIL=PalaRadar <alertas@palaradar.es>

# Clave para la huella de IP que limita abusos (no se guarda la IP) y para firmar
# los enlaces de acceso de «Mis alertas». Cualquier cadena larga y aleatoria.
# Necesaria en producción: sin ella, «Mis alertas» no ofrece el acceso por correo.
# ALERTS_SECRET=

# Solo en local: sin Resend, `next dev` escribe los correos en la terminal en vez
# de enviarlos. Con `next start` hay que pedirlo: ALERTS_MAILER=console. Nunca
# se usa en Vercel. Los enlaces de esos correos apuntan a http://localhost:3000;
# se puede cambiar con ALERTS_DEV_BASE_URL.
# ALERTS_MAILER=console

# Los enlaces de los correos usan NEXT_PUBLIC_SITE_URL (ver «Sitio»).

# --- Sitio -------------------------------------------------------------------
# Dominio para canónicas y sitemap.
# NEXT_PUBLIC_SITE_URL=https://palaradar.es

# Correo de contacto que se publica en la política de privacidad (/privacidad/).
# Sin él, la página solo remite al enlace de baja de los correos.
# NEXT_PUBLIC_CONTACT_EMAIL=

# "true" para permitir la indexación. Sin ella todo el sitio va con noindex.
# NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Analítica ---------------------------------------------------------------
# Por defecto no hay analítica: la web no mide nada ni carga scripts de terceros.
# "plausible" entrega los eventos de producto (lib/analytics.ts) a Plausible, que
# no usa cookies; necesita además el dominio dado de alta allí. "console" solo
# los escribe en la consola del navegador, para comprobarlos en desarrollo.
# NEXT_PUBLIC_ANALYTICS_PROVIDER=
# NEXT_PUBLIC_ANALYTICS_DOMAIN=
