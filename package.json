{
  "name": "palaradar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:db": "tsx --env-file-if-exists=.env.local --test --test-concurrency=1 \"tests/db/*.test.ts\"",
    "art": "tsx scripts/generate-art.ts",
    "ingest:demo": "tsx scripts/ingest-demo.ts",
    "prices:dry-run": "tsx --env-file-if-exists=.env.local scripts/prices/dry-run.ts",
    "prices:ingest": "tsx --env-file-if-exists=.env.local scripts/prices/ingest.ts",
    "prices:pending": "tsx --env-file-if-exists=.env.local scripts/prices/pending.ts",
    "catalog:import": "tsx --env-file-if-exists=.env.local scripts/catalog/import.ts",
    "media:import": "tsx --env-file-if-exists=.env.local scripts/media/import.ts",
    "media:report": "tsx --env-file-if-exists=.env.local scripts/media/report.ts",
    "media:review": "tsx --env-file-if-exists=.env.local scripts/media/review.ts",
    "db:purge-demo": "tsx --env-file-if-exists=.env.local scripts/db/purge-demo.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/db/seed.ts",
    "db:seed:dev": "tsx --env-file-if-exists=.env.local scripts/db/seed-dev.ts",
    "db:stats": "tsx --env-file-if-exists=.env.local scripts/db/stats.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
